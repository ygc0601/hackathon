rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function hasValidAccessibilitySettings() {
      let data = request.resource.data;

      return data.keys().hasAll([
          'easyLanguageLevel',
          'sentenceLength',
          'fontSize',
          'showPictograms',
          'speechRate',
          'highContrast'
        ])
        && data.keys().hasOnly([
          'easyLanguageLevel',
          'sentenceLength',
          'fontSize',
          'showPictograms',
          'speechRate',
          'highContrast',
          'updatedAt'
        ])
        && data.easyLanguageLevel in ['basic', 'standard']
        && data.sentenceLength in ['short', 'medium']
        && data.fontSize in ['large', 'extraLarge']
        && data.showPictograms is bool
        && data.highContrast is bool
        && data.speechRate is number
        && data.speechRate >= 0.5
        && data.speechRate <= 1.0
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    match /userProfiles/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.email == request.auth.token.email;
      allow update: if isOwner(userId)
        && request.resource.data.email == resource.data.email;
      allow delete: if isOwner(userId);
    }

    match /accessibilityProfiles/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && hasValidAccessibilitySettings();
      allow delete: if isOwner(userId);
    }
  }
}
